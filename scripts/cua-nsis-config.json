        ["Cart", "Cart"],
        ["Jobs", "Jobs"],
        ["Vet", "Vet"],
        ["Logs", "Logs"],
        ["Onboarding", "Onboarding"],
        ["Settings", "Settings"],
        ["Help", "Help"]
